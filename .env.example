# Root Environment Template
PORT=5001
NODE_ENV=development

# Database (Supabase)
DATABASE_URL=postgres://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

# Auth
JWT_SECRET=[GENERATE_RANDOM_SECRET]
JWT_REFRESH_SECRET=[GENERATE_RANDOM_SECRET]

# Push Notifications (Vapid)
VAPID_PUBLIC_KEY=[USE_THE_NEW_PUBLIC_KEY_I_GENERATED]
VAPID_PRIVATE_KEY=[USE_THE_NEW_PRIVATE_KEY_I_GENERATED]
VAPID_EMAIL=mailto:admin@example.com

# Email Service
EMAIL_USER=[YOUR_EMAIL]
EMAIL_PASS=[YOUR_APP_PASSWORD_OR_API_KEY]
RESEND_API_KEY=re_[YOUR_RE_KEY]

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Firebase (FCM Push Notifications)
# Get these values from your Firebase Console → Project Settings → General → Your apps
# NEVER hardcode these in source files — they are injected into the service worker at build time.
VITE_FIREBASE_API_KEY=[YOUR_FIREBASE_API_KEY]
VITE_FIREBASE_AUTH_DOMAIN=[YOUR_PROJECT_ID].firebaseapp.com
VITE_FIREBASE_PROJECT_ID=[YOUR_PROJECT_ID]
VITE_FIREBASE_STORAGE_BUCKET=[YOUR_PROJECT_ID].firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=[YOUR_SENDER_ID]
VITE_FIREBASE_APP_ID=[YOUR_APP_ID]
VITE_FIREBASE_VAPID_KEY=[YOUR_VAPID_PUBLIC_KEY]
