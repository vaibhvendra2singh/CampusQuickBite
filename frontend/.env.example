# This is a sample .env file for the frontend
# When deploying, you need to set these in your hosting provider's environment variables dashboard

# The URL of your deployed backend API
# Example: https://my-campus-backend.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# The URL of your deployed backend Socket.IO server
# Example: https://my-campus-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5001
