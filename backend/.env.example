# Backend Environment Template
PORT=5001
NODE_ENV=development

# Database (Supabase)
DATABASE_URL=postgres://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# Auth Secret Keys
JWT_SECRET=[GENERATE_RANDOM_SECRET]
JWT_REFRESH_SECRET=[GENERATE_RANDOM_SECRET]

# Vapid (Push Notifications)
VAPID_PUBLIC_KEY=[USE_THE_NEW_PUBLIC_KEY_I_GENERATED]
VAPID_PRIVATE_KEY=[USE_THE_NEW_PRIVATE_KEY_I_GENERATED]
VAPID_EMAIL=mailto:admin@example.com

# Email / Support
SUPPORT_EMAIL=support@yourdomain.com
EMAIL_USER=[SMTP_USER]
EMAIL_PASS=[SMTP_PASS]

# Clients
CORS_ORIGIN=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173

# Razorpay Configuration (Get these from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=secret_placeholder
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
