# ============================================
# CampusBite Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication
JWT_SECRET=change-me-to-a-strong-random-secret

# Server
PORT=5001

# The URL of your deployed frontend (required for CORS in production)
# Example: https://my-campus-frontend.vercel.app
# FRONTEND_URL=

# Nodemailer Settings (Gmail)
# We recommend using a Gmail App Password
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password

REDIS_URL=redis://localhost:6379
JWT_REFRESH_SECRET=your-refresh-secret-here
